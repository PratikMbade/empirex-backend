# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/empirex

# ── Chain ─────────────────────────────────────────────────
# 56 = BNB Smart Chain, 97 = BSC testnet
CHAIN_ID=56
RPC_HTTP_URL=https://bnb-mainnet.g.alchemy.com/v2/bkogFv9CddJgRlPtb7ip6wMy_a8W8C5g
# Optional HTTPS backup used when RPC_HTTP_URL is unavailable. Best from a different provider.
# RPC_HTTP_FALLBACK_URL=
# Optional. Without it the indexer polls every POLL_INTERVAL_MS instead of reacting to live events.
RPC_WS_URL=wss://bnb-mainnet.g.alchemy.com/v2/bkogFv9CddJgRlPtb7ip6wMy_a8W8C5g
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
# Block the contract was deployed in; the first sync starts here.
CONTRACT_DEPLOY_BLOCK=0
TOKEN_DECIMALS=18

# ── Indexer ───────────────────────────────────────────────
CONFIRMATIONS=3
LOG_BATCH_BLOCKS=500
POLL_INTERVAL_MS=30000

# ── API ───────────────────────────────────────────────────
PORT=4000
# Comma-separated frontend origins allowed to call the API with cookies
CORS_ORIGINS=http://localhost:5173
BETTER_AUTH_URL=http://localhost:4000
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Host the frontend's Sign-In with Ethereum message is created for
SIWE_DOMAIN=localhost:5173
# Production only, to share the session across subdomains, e.g. .empirex.io
# COOKIE_DOMAIN=
